-- ── Global key listener ───────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(i, gpe)

    -- ── Toggles-tab inline feature bind capture ───────────────────────────────
    if listeningFeature then
        if i.KeyCode == Enum.KeyCode.Escape then
            setFeatureListening(listeningFeature, false)
            return
        end
        if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if FORBIDDEN_FEATURE_KEYS[i.KeyCode] then return end

        local slot = listeningFeature
        featureBinds[slot] = i.KeyCode
        setFeatureListening(slot, false)

        Notify("Feature bind [" .. slot .. "] → " .. keyName(i.KeyCode), true)
        return
    end

    if gpe then return end

    -- ── System hotkeys ────────────────────────────────────────────────────────
    if i.KeyCode == binds.Menu then
        Frame.Visible = not Frame.Visible

    elseif i.KeyCode == binds.Fly then
        local now = tick()
        if toggleDebounce["Fly"] and (now - toggleDebounce["Fly"]) < 0.15 then return end
        toggleDebounce["Fly"] = now
        local newState = not cfg.Fly
        cfg.Fly = newState
        if pillRefreshers["Fly"] then pillRefreshers["Fly"](newState) end
        Notify("Fly  >>  " .. (newState and "ON" or "OFF"), newState)
        SetFly(newState)

    elseif i.KeyCode == binds.Noclip then
        local now = tick()
        if toggleDebounce["Noclip"] and (now - toggleDebounce["Noclip"]) < 0.15 then return end
        toggleDebounce["Noclip"] = now
        local newState = not cfg.Noclip
        cfg.Noclip = newState
        if pillRefreshers["Noclip"] then pillRefreshers["Noclip"](newState) end
        Notify("Noclip  >>  " .. (newState and "ON" or "OFF"), newState)
        SetNoclip(newState)

    elseif i.KeyCode == binds.TP then
        local now = tick()
        if toggleDebounce["TP"] and (now - toggleDebounce["TP"]) < 0.15 then return end
        toggleDebounce["TP"] = now
        local newState = not cfg.TP
        cfg.TP = newState
        if pillRefreshers["TP"] then pillRefreshers["TP"](newState) end
        Notify("TP ItemCache  >>  " .. (newState and "ON" or "OFF"), newState)
        if newState then StartTPLoop() else StopTPLoop() end

    else
        -- ── Fire feature keybinds ─────────────────────────────────────────────
        for cfgKey, kc in pairs(featureBinds) do
            if i.KeyCode == kc then
                local now = tick()
                if toggleDebounce[cfgKey] and (now - toggleDebounce[cfgKey]) < 0.15 then break end
                toggleDebounce[cfgKey] = now
                local newState = not cfg[cfgKey]
                cfg[cfgKey] = newState
                if pillRefreshers[cfgKey] then pillRefreshers[cfgKey](newState) end
                Notify(cfgKey .. "  >>  " .. (newState and "ON" or "OFF"), newState)
                break
            end
        end
    end
end)

-- ── ESP ───────────────────────────────────────────────────────────────────────
local GlobalTargets   = {}
local DrawingCache    = {}
local MobTargets      = {}
local MobDrawingCache = {}

local function PerformScan()
    local temp = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    table.insert(temp, {Player=player, Character=char, Root=root, Hum=hum})
                end
            end
        end
    end
    GlobalTargets = temp
end

local function PerformMobScan()
    local temp       = {}
    local liveFolder = workspace:FindFirstChild("Live")
    if not liveFolder then return end
    for _, obj in pairs(liveFolder:GetChildren()) do
        if not obj:FindFirstChild("Loaded") then
            local root = obj:FindFirstChild("HumanoidRootPart")
                      or obj:FindFirstChild("Torso")
                      or (obj:IsA("Model") and obj.PrimaryPart)
            local hum  = obj:FindFirstChildOfClass("Humanoid")
            if root then table.insert(temp, {Object=obj, Root=root, Hum=hum}) end
        end
    end
    MobTargets = temp
end

task.spawn(function() while _G.Kraken_Active do PerformScan()    task.wait(1) end end)
task.spawn(function() while _G.Kraken_Active do PerformMobScan() task.wait(1) end end)

local playerESPKeys = {"Box","StatLevel","Name","Health","Dist"}
local mobESPKeys    = {"Box","Name","Health","Dist"}

local function hideDrawings(d, keys)
    for _, k in ipairs(keys) do if d[k] then d[k].Visible = false end end
end
local function removeDrawings(d, keys)
    for _, k in ipairs(keys) do if d[k] then pcall(function() d[k]:Remove() end) end end
end
local function buildLookup(targets, field)
    local set = {}
    for _, t in ipairs(targets) do set[t[field]] = true end
    return set
end

local espFrame = 0

RunService.RenderStepped:Connect(function()
    espFrame = espFrame + 1
    if espFrame % 2 ~= 0 then return end

    local charSet = buildLookup(GlobalTargets, "Character")
    for char, d in pairs(DrawingCache) do
        if not charSet[char] then removeDrawings(d, playerESPKeys) DrawingCache[char] = nil
        elseif not cfg.ESP   then hideDrawings(d, playerESPKeys) end
    end

    local mobSet = buildLookup(MobTargets, "Object")
    for obj, d in pairs(MobDrawingCache) do
        if not mobSet[obj]    then removeDrawings(d, mobESPKeys) MobDrawingCache[obj] = nil
        elseif not cfg.MobESP then hideDrawings(d, mobESPKeys) end
    end

    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local localPos  = localRoot and localRoot.Position

    if cfg.ESP then
        for _, data in ipairs(GlobalTargets) do
            if not data.Character.Parent then continue end
            if localPos then
                local dist = (data.Root.Position - localPos).Magnitude
                if dist > cfg.ESPMaxDist then
                    local d = DrawingCache[data.Character]
                    if d then hideDrawings(d, playerESPKeys) end
                    continue
                end
            end
            if not DrawingCache[data.Character] then
                DrawingCache[data.Character] = {
                    Box       = Drawing.new("Square"),
                    Name      = Drawing.new("Text"),
                    StatLevel = Drawing.new("Text"),
                    Health    = Drawing.new("Square"),
                    Dist      = Drawing.new("Text"),
                }
            end
            local d = DrawingCache[data.Character]
            local sPos, onScreen = Camera:WorldToViewportPoint(data.Root.Position)
            if not onScreen then hideDrawings(d, playerESPKeys) continue end

            local headPos = Camera:WorldToViewportPoint(data.Root.Position + Vector3.new(0, 3, 0))
            local h = math.abs(headPos.Y - sPos.Y) * 2
            local w = h / 1.5

            if cfg.Box then
                d.Box.Visible = true; d.Box.Size = Vector2.new(w, h)
                d.Box.Position = Vector2.new(sPos.X - w/2, sPos.Y - h/2)
                d.Box.Color = cfg.Accent; d.Box.Thickness = 2
                d.Box.Filled = false; d.Box.Transparency = 1
            else d.Box.Visible = false end

            if cfg.Name then
                d.Name.Visible = true; d.Name.Text = data.Player.Name
                d.Name.Position = Vector2.new(sPos.X, sPos.Y - h/2 - 15)
                d.Name.Center = true; d.Name.Color = cfg.Text
                d.Name.Size = 14; d.Name.Outline = true; d.Name.Font = 2
            else d.Name.Visible = false end

            local statLevel = nil
            if cfg.Name then
                local lf = workspace:FindFirstChild("Live")
                if lf then
                    for _, obj in pairs(lf:GetChildren()) do
                        if obj:GetAttribute("StatLevel") and obj.Name == data.Player.Name then
                            statLevel = obj:GetAttribute("StatLevel") break
                        end
                    end
                end
            end
            if statLevel then
                d.StatLevel.Visible = true
                d.StatLevel.Text = "Lv." .. tostring(statLevel)
                d.StatLevel.Position = Vector2.new(sPos.X, sPos.Y - h/2 - 28)
                d.StatLevel.Center = true; d.StatLevel.Color = Color3.fromRGB(150, 200, 170)
                d.StatLevel.Size = 13; d.StatLevel.Outline = true; d.StatLevel.Font = 2
            else d.StatLevel.Visible = false end

            if cfg.Health then
                local hp = data.Hum.Health / math.max(data.Hum.MaxHealth, 1)
                d.Health.Visible = true; d.Health.Size = Vector2.new(3, h * hp)
                d.Health.Position = Vector2.new(sPos.X - w/2 - 5, sPos.Y + h/2 - h * hp)
                d.Health.Color = Color3.new(0, 1, 0); d.Health.Filled = true; d.Health.Transparency = 1
            else d.Health.Visible = false end

            if cfg.Dist and localPos then
                local dist = (localPos - data.Root.Position).Magnitude
                d.Dist.Visible = true; d.Dist.Text = math.floor(dist) .. "m"
                d.Dist.Position = Vector2.new(sPos.X, sPos.Y + h/2 + 4)
                d.Dist.Center = true; d.Dist.Color = cfg.Text
                d.Dist.Size = 13; d.Dist.Outline = true; d.Dist.Font = 2
            else d.Dist.Visible = false end
        end
    end

    if cfg.MobESP then
        for _, data in ipairs(MobTargets) do
            if not data.Object.Parent then continue end
            if localPos then
                local dist = (data.Root.Position - localPos).Magnitude
                if dist > cfg.ESPMaxDist then
                    local d = MobDrawingCache[data.Object]
                    if d then hideDrawings(d, mobESPKeys) end
                    continue
                end
            end
            if not MobDrawingCache[data.Object] then
                MobDrawingCache[data.Object] = {
                    Box    = Drawing.new("Square"),
                    Name   = Drawing.new("Text"),
                    Health = Drawing.new("Square"),
                    Dist   = Drawing.new("Text"),
                }
            end
            local d = MobDrawingCache[data.Object]
            local sPos, onScreen = Camera:WorldToViewportPoint(data.Root.Position)
            if not onScreen then hideDrawings(d, mobESPKeys) continue end

            local headPos = Camera:WorldToViewportPoint(data.Root.Position + Vector3.new(0, 3, 0))
            local h = math.abs(headPos.Y - sPos.Y) * 2
            local w = h / 1.5

            d.Box.Visible = true; d.Box.Size = Vector2.new(w, h)
            d.Box.Position = Vector2.new(sPos.X - w/2, sPos.Y - h/2)
            d.Box.Color = Color3.fromRGB(255, 165, 0); d.Box.Thickness = 2
            d.Box.Filled = false; d.Box.Transparency = 1

            d.Name.Visible = true; d.Name.Text = data.Object.Name
            d.Name.Position = Vector2.new(sPos.X, sPos.Y - h/2 - 15)
            d.Name.Center = true; d.Name.Color = Color3.fromRGB(255, 255, 200)
            d.Name.Size = 13; d.Name.Outline = true; d.Name.Font = 2

            if data.Hum then
                local hp = data.Hum.Health / math.max(data.Hum.MaxHealth, 1)
                d.Health.Visible = true; d.Health.Size = Vector2.new(3, h * hp)
                d.Health.Position = Vector2.new(sPos.X - w/2 - 5, sPos.Y + h/2 - h * hp)
                d.Health.Color = Color3.new(1, 0.5, 0); d.Health.Filled = true; d.Health.Transparency = 1
            else d.Health.Visible = false end

            if localPos then
                local dist = (localPos - data.Root.Position).Magnitude
                d.Dist.Visible = true; d.Dist.Text = math.floor(dist) .. "m"
                d.Dist.Position = Vector2.new(sPos.X, sPos.Y + h/2 + 4)
                d.Dist.Center = true; d.Dist.Color = Color3.fromRGB(255, 255, 200)
                d.Dist.Size = 12; d.Dist.Outline = true; d.Dist.Font = 2
            else d.Dist.Visible = false end
        end
    end
end)

