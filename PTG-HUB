-- ── Config Save/Load ──────────────────────────────────────────────────────────
local CFG_FOLDER  = "Kraken"
local AUTO_FILE   = "Kraken/kraken_autoload.txt"

local SAVEABLE_KEYS = {
    "ESP", "MobESP", "Fly", "Noclip", "TP", "LootLoop",
    "InfiniteStamina", "FPSBoost", "CFspeed", "ESPMaxDist",
    "ShowPerfBar",
}
local SAVEABLE_BINDS = { "Menu", "Fly", "Noclip", "TP" }

local cfgCurrentName = "default"

local function ensureFolder()
    if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
end

local function cfgPath(name)
    return CFG_FOLDER .. "/" .. name .. ".json"
end

local function serializeCfg()
    local data = { cfg = {}, binds = {} }
    for _, k in ipairs(SAVEABLE_KEYS) do
        local v = cfg[k]
        if type(v) == "boolean" or type(v) == "number" then
            data.cfg[k] = v
        end
    end
    for _, k in ipairs(SAVEABLE_BINDS) do
        data.binds[k] = tostring(binds[k])
    end
    return HttpService:JSONEncode(data)
end

local function deserializeCfg(raw)
    local decoded
    local ok = pcall(function() decoded = HttpService:JSONDecode(raw) end)
    if not ok or not decoded then return false end
    if decoded.cfg then
        for _, k in ipairs(SAVEABLE_KEYS) do
            if decoded.cfg[k] ~= nil then cfg[k] = decoded.cfg[k] end
        end
    end
    if decoded.binds then
        for _, k in ipairs(SAVEABLE_BINDS) do
            local rb = decoded.binds[k]
            if rb then
                local kc = Enum.KeyCode[rb:match("KeyCode%.(.+)") or rb]
                if kc then binds[k] = kc end
            end
        end
    end
    return true
end

local function saveConfig(name)
    ensureFolder()
    local ok, err = pcall(writefile, cfgPath(name), serializeCfg())
    if not ok then warn("Kraken: save failed —", err) end
    return ok
end

local function loadConfig(name)
    ensureFolder()
    local path = cfgPath(name)
    if not isfile(path) then return false, "not found" end
    local ok, raw = pcall(readfile, path)
    if not ok then return false, "read error" end
    local parsed = deserializeCfg(raw)
    return parsed, parsed and "ok" or "parse error"
end

local function deleteConfig(name)
    ensureFolder()
    local path = cfgPath(name)
    if not isfile(path) then return false end
    local ok = pcall(delfile, path)
    return ok
end

local function listConfigs()
    ensureFolder()
    local files = {}
    local ok, result = pcall(listfiles, CFG_FOLDER)
    if not ok then return files end
    for _, f in ipairs(result) do
        local name = f:match("([^/\\]+)%.json$")
        if name then table.insert(files, name) end
    end
    return files
end

local function getAutoLoad()
    if not isfile(AUTO_FILE) then return nil end
    local ok, raw = pcall(readfile, AUTO_FILE)
    return (ok and raw ~= "") and raw or nil
end

local function setAutoLoad(name)
    ensureFolder()
    pcall(writefile, AUTO_FILE, name or "")
end

local function clearAutoLoad()
    if isfile(AUTO_FILE) then pcall(delfile, AUTO_FILE) end
end

-- ── Fly ──────────────────────────────────────────────────────────────────────
local flyActive = false
local flyConn_kDown, flyConn_kUp
local BG_fly, BV_fly
local ctrl  = {F=0, B=0, L=0, R=0, Q=0, E=0}
local lctrl = {F=0, B=0, L=0, R=0, Q=0, E=0}

local function resetCtrl()
    for k in pairs(ctrl)  do ctrl[k]  = 0 end
    for k in pairs(lctrl) do lctrl[k] = 0 end
end

local function NOFLY()
    flyActive = false
    if flyConn_kDown then flyConn_kDown:Disconnect() flyConn_kDown = nil end
    if flyConn_kUp   then flyConn_kUp:Disconnect()   flyConn_kUp   = nil end
    local bg = BG_fly
    local bv = BV_fly
    BG_fly, BV_fly = nil, nil
    if bg and bg.Parent then pcall(function() bg:Destroy() end) end
    if bv and bv.Parent then pcall(function() bv:Destroy() end) end
    resetCtrl()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
        Camera.CameraType = Enum.CameraType.Custom
    end)
end

local function FLY()
    local char = LocalPlayer.Character
    if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end
    if flyActive then
        flyActive = false
        if flyConn_kDown then flyConn_kDown:Disconnect() flyConn_kDown = nil end
        if flyConn_kUp   then flyConn_kUp:Disconnect()   flyConn_kUp   = nil end
        local oldBG = BG_fly; local oldBV = BV_fly
        BG_fly, BV_fly = nil, nil
        if oldBG and oldBG.Parent then pcall(function() oldBG:Destroy() end) end
        if oldBV and oldBV.Parent then pcall(function() oldBV:Destroy() end) end
        resetCtrl()
    end
    flyActive = true
    resetCtrl()
    BG_fly = Instance.new("BodyGyro", root)
    BV_fly = Instance.new("BodyVelocity", root)
    BG_fly.P          = 9e4
    BG_fly.MaxTorque  = Vector3.new(9e9, 9e9, 9e9)
    BG_fly.CFrame     = root.CFrame
    BV_fly.MaxForce   = Vector3.new(9e9, 9e9, 9e9)
    BV_fly.Velocity   = Vector3.new()
    local sessionBG = BG_fly
    local sessionBV = BV_fly
    task.spawn(function()
        while flyActive and _G.Kraken_Active do
            if BG_fly ~= sessionBG or BV_fly ~= sessionBV then break end
            if not sessionBG.Parent or not sessionBV.Parent then break end
            hum.PlatformStand = true
            local cf = Camera.CFrame
            local dx = ctrl.L  + ctrl.R
            local dz = ctrl.F  + ctrl.B
            local dy = ctrl.Q  + ctrl.E
            if dx ~= 0 or dz ~= 0 or dy ~= 0 then
                local fwd   = cf.LookVector  * dz
                local right = cf.RightVector * dx
                local up    = Vector3.new(0, dy, 0)
                sessionBV.Velocity = (fwd + right + up) * cfg.CFspeed
            else
                sessionBV.Velocity = sessionBV.Velocity * 0.85
                if sessionBV.Velocity.Magnitude < 0.5 then sessionBV.Velocity = Vector3.new() end
            end
            sessionBG.CFrame = cf
            task.wait()
        end
        pcall(function()
            if sessionBG.Parent then sessionBG:Destroy() end
            if sessionBV.Parent then sessionBV:Destroy() end
            if hum and hum.Parent then hum.PlatformStand = false end
        end)
    end)
    local keyMap = {
        [Enum.KeyCode.W] = {slot="F",  val= 1},
        [Enum.KeyCode.S] = {slot="B",  val=-1},
        [Enum.KeyCode.A] = {slot="L",  val=-1},
        [Enum.KeyCode.D] = {slot="R",  val= 1},
        [Enum.KeyCode.E] = {slot="Q",  val= 1},
        [Enum.KeyCode.Q] = {slot="E",  val=-1},
    }
    flyConn_kDown = UserInputService.InputBegan:Connect(function(i, p)
        if p then return end
        local m = keyMap[i.KeyCode]
        if m then ctrl[m.slot] = m.val end
    end)
    flyConn_kUp = UserInputService.InputEnded:Connect(function(i, p)
        if p then return end
        local m = keyMap[i.KeyCode]
        if m then ctrl[m.slot] = 0 end
    end)
end

-- ── Noclip ───────────────────────────────────────────────────────────────────
local noclipConn       = nil
local noclipDescConn   = nil
local noclipSnapshot   = {}
local noclipApplied    = {}

local function noclipApplyPart(part)
    if not part:IsA("BasePart") then return end
    if noclipSnapshot[part] == nil then
        noclipSnapshot[part] = part.CanCollide
    end
    part.CanCollide    = false
    noclipApplied[part] = true
end

local function noclipApplyChar(char)
    for _, d in ipairs(char:GetDescendants()) do noclipApplyPart(d) end
end

local function noclipRestoreChar(char)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            local orig = noclipSnapshot[d]
            d.CanCollide = (orig ~= nil) and orig or true
        end
    end
    noclipSnapshot = {}
    noclipApplied  = {}
end

local function startNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    noclipSnapshot = {}
    noclipApplied  = {}
    noclipApplyChar(char)
    if noclipDescConn then noclipDescConn:Disconnect() end
    noclipDescConn = char.DescendantAdded:Connect(function(d)
        if cfg.Noclip and _G.Kraken_Active then noclipApplyPart(d) end
    end)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not cfg.Noclip or not _G.Kraken_Active then return end
        local c = LocalPlayer.Character
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then
                if noclipSnapshot[d] == nil then noclipSnapshot[d] = true end
                d.CanCollide    = false
                noclipApplied[d] = true
            end
        end
    end)
end

local function stopNoclip()
    if noclipConn     then noclipConn:Disconnect()     noclipConn     = nil end
    if noclipDescConn then noclipDescConn:Disconnect() noclipDescConn = nil end
    noclipRestoreChar(LocalPlayer.Character)
end

function SetNoclip(v)
    cfg.Noclip = v
    if v then startNoclip() else stopNoclip() end
end

-- ── FPS Boost ────────────────────────────────────────────────────────────────
local fpsBoostActive = false
local originalState = {}
local fpsBoostDescConn = nil

local function stripTerrain()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return end
    if originalState[terrain] == nil then
        originalState[terrain] = {
            type              = "Terrain",
            WaterColor        = terrain.WaterColor,
            WaterReflectance  = terrain.WaterReflectance,
            WaterTransparency = terrain.WaterTransparency,
            WaterWaveSize     = terrain.WaterWaveSize,
            WaterWaveSpeed    = terrain.WaterWaveSpeed,
        }
    end
    terrain.WaterColor        = Color3.fromRGB(0, 100, 255)
    terrain.WaterReflectance  = 0
    terrain.WaterTransparency = 0
    terrain.WaterWaveSize     = 0
    terrain.WaterWaveSpeed    = 0
end

local function restoreTerrain()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return end
    local saved = originalState[terrain]
    if not saved then return end
    pcall(function()
        terrain.WaterColor        = saved.WaterColor
        terrain.WaterReflectance  = saved.WaterReflectance
        terrain.WaterTransparency = saved.WaterTransparency
        terrain.WaterWaveSize     = saved.WaterWaveSize
        terrain.WaterWaveSpeed    = saved.WaterWaveSpeed
    end)
    originalState[terrain] = nil
end

local function stripPart(obj)
    if obj:IsA("BasePart") then
        if originalState[obj] == nil then
            originalState[obj] = {
                type     = "BasePart",
                Material = obj.Material,
                Color    = obj.Color,
            }
        end
        obj.Material = Enum.Material.SmoothPlastic

    elseif obj:IsA("SurfaceAppearance") then
        if originalState[obj] == nil then
            originalState[obj] = {
                type         = "SurfaceAppearance",
                ColorMap     = obj.ColorMap,
                NormalMap    = obj.NormalMap,
                RoughnessMap = obj.RoughnessMap,
                MetalnessMap = obj.MetalnessMap,
            }
        end
        obj.ColorMap     = ""
        obj.NormalMap    = ""
        obj.RoughnessMap = ""
        obj.MetalnessMap = ""

    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        if originalState[obj] == nil then
            originalState[obj] = {
                type         = "TextureDecal",
                Texture      = obj.Texture,
                Transparency = obj.Transparency,
            }
        end
        obj.Texture      = ""
        obj.Transparency = 1

    elseif obj:IsA("SpecialMesh") then
        if obj.TextureId ~= "" and originalState[obj] == nil then
            originalState[obj] = {
                type      = "SpecialMesh",
                TextureId = obj.TextureId,
            }
            obj.TextureId = ""
        end

    elseif obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect")
        or obj:IsA("ColorCorrectionEffect") or obj:IsA("DepthOfFieldEffect") then
        if originalState[obj] == nil then
            originalState[obj] = { type = "Effect", Enabled = obj.Enabled }
        end
        obj.Enabled = false
    end
end

local function restorePart(obj, saved)
    pcall(function()
        if not obj or not obj.Parent then return end
        local t = saved.type
        if t == "BasePart" then
            obj.Material = saved.Material
            obj.Color    = saved.Color
        elseif t == "SurfaceAppearance" then
            obj.ColorMap     = saved.ColorMap
            obj.NormalMap    = saved.NormalMap
            obj.RoughnessMap = saved.RoughnessMap
            obj.MetalnessMap = saved.MetalnessMap
        elseif t == "TextureDecal" then
            obj.Texture      = saved.Texture
            obj.Transparency = saved.Transparency
        elseif t == "SpecialMesh" then
            obj.TextureId = saved.TextureId
        elseif t == "Effect" then
            obj.Enabled = saved.Enabled
        end
    end)
end

local function applyFPSBoost()
    if fpsBoostActive then return end
    fpsBoostActive = true
    stripTerrain()
    for _, obj in pairs(workspace:GetDescendants()) do stripPart(obj) end
    for _, obj in pairs(game:GetService("Lighting"):GetChildren()) do stripPart(obj) end
    fpsBoostDescConn = workspace.DescendantAdded:Connect(function(obj)
        if fpsBoostActive then
            task.defer(function()
                if obj and obj.Parent and fpsBoostActive then stripPart(obj) end
            end)
        end
    end)
end

local function removeFPSBoost()
    if not fpsBoostActive then return end
    fpsBoostActive = false
    restoreTerrain()
    if fpsBoostDescConn then fpsBoostDescConn:Disconnect() fpsBoostDescConn = nil end
    for obj, saved in pairs(originalState) do restorePart(obj, saved) end
    originalState = {}
end

function SetFPSBoost(v)
    cfg.FPSBoost = v
    if v then applyFPSBoost() else removeFPSBoost() end
end

