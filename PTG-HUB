local function perfColor(val, warnAt, badAt, higherIsBad)
    if higherIsBad then
        if val >= badAt  then return Color3.fromRGB(255, 70, 70)  end
        if val >= warnAt then return Color3.fromRGB(255, 200, 50) end
    else
        if val <= badAt  then return Color3.fromRGB(255, 70, 70)  end
        if val <= warnAt then return Color3.fromRGB(255, 200, 50) end
    end
    return cfg.Accent
end

