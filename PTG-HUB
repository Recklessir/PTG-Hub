    frameCount += 1
    fpsAccum   += 1 / dt
    local now = tick()
    if now - lastPerfUpdate >= perfCfg.UpdateRate then
        if perfCfg.ShowFPS then
            local fps = math.floor(fpsAccum / frameCount)
            FPSLabel.Text       = fps .. " " .. perfCfg.LabelFPS
            FPSLabel.TextColor3 = perfColor(fps, perfCfg.FPSWarn, perfCfg.FPSBad, false)
        end
        if perfCfg.ShowPing then
            local ok, ping = pcall(function()
                return math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            local pingVal = ok and ping or 0
            PingLabel.Text       = pingVal .. " " .. perfCfg.LabelPing
            PingLabel.TextColor3 = perfColor(pingVal, perfCfg.PingWarn, perfCfg.PingBad, true)
        end
        frameCount     = 0
        fpsAccum       = 0
        lastPerfUpdate = now
    end
end)

