-- ── Placeholder Slider builder ────────────────────────────────────────────────
local function PlaceholderSlider(parent, labelText, order, minVal, maxVal, defaultVal, cfgKey)
    local Row = Instance.new("Frame", parent)
    Row.LayoutOrder = order
    Row.Size = UDim2.new(1, 0, 0, 36)
    Row.BackgroundTransparency = 1

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(0.55, 0, 1, 0)
    Lbl.Text = "· " .. labelText
    Lbl.Font = Enum.Font.Code
    Lbl.TextSize = 13
    Lbl.TextColor3 = cfg.Text
    Lbl.TextTransparency = 0.2
    Lbl.BackgroundTransparency = 1
    Lbl.TextXAlignment = Enum.TextXAlignment.Left

    local Val = Instance.new("TextLabel", Row)
    Val.Size = UDim2.new(0.15, 0, 1, 0)
    Val.Position = UDim2.new(0.52, 0, 0, 0)
    Val.Text = tostring(defaultVal)
    Val.Font = Enum.Font.Code
    Val.TextSize = 13
    Val.TextColor3 = cfg.Accent
    Val.BackgroundTransparency = 1
    Val.TextXAlignment = Enum.TextXAlignment.Right

    local Track = Instance.new("Frame", Row)
    Track.Size = UDim2.new(0.3, 0, 0, 5)
    Track.Position = UDim2.new(0.69, 0, 0.5, -2)
    Track.BackgroundColor3 = Color3.fromRGB(22, 38, 28)
    Track.BorderSizePixel = 0
    Instance.new("UICorner", Track).CornerRadius = UDim.new(0, 3)

    local initRel = (defaultVal - minVal) / (maxVal - minVal)

    local Fill = Instance.new("Frame", Track)
    Fill.Size = UDim2.new(initRel, 0, 1, 0)
    Fill.BackgroundColor3 = cfg.Accent
    Fill.BorderSizePixel = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 3)

    local Thumb = Instance.new("TextButton", Track)
    Thumb.Size = UDim2.new(0, 13, 0, 13)
    Thumb.Position = UDim2.new(initRel, -6, 0.5, -6)
    Thumb.BackgroundColor3 = cfg.Accent
    Thumb.Text = ""
    Thumb.BorderSizePixel = 0
    Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

    local dragging = false
    Thumb.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    RunService.RenderStepped:Connect(function()
        if not dragging then return end
        local mouse    = UserInputService:GetMouseLocation()
        local trackPos = Track.AbsolutePosition
        local trackSz  = Track.AbsoluteSize
        local rel      = math.clamp((mouse.X - trackPos.X) / trackSz.X, 0, 1)
        local newVal   = math.floor(minVal + rel * (maxVal - minVal))
        if cfgKey then cfg[cfgKey] = newVal end
        Fill.Size      = UDim2.new(rel, 0, 1, 0)
        Thumb.Position = UDim2.new(rel, -6, 0.5, -6)
        Val.Text       = tostring(newVal)
    end)

    return Row
end

