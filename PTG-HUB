local lootInterval     = 0.2
local lootTPDelay      = 1
local lootLoopDuration = 15

local function TeleportToItemCache()
    local thrown = workspace:FindFirstChild("Thrown")
    local item   = thrown and thrown:FindFirstChild("itemCacheModel")
    if not item then TPStatusLabel.Text = "No itemCache found" return false end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local root = char.HumanoidRootPart
    local targetCF = item:IsA("Model") and item:GetPivot() or item.CFrame
    root.CFrame = targetCF + Vector3.new(math.random(-5,5)/10, 3, math.random(-5,5)/10)
    TPStatusLabel.Text = "ItemCache TP done"
    HintLabel.Visible  = false
    return true
end

local function StartTPLoop()
    if TPLoopConnection then return end
    HintLabel.Visible = false
    TPLoopConnection = task.spawn(function()
        local vu = game:GetService("VirtualInputManager")
        local lastXPress = 0
        while cfg.TP and _G.Kraken_Active do
            local now = tick()
            if now - lastXPress > 0.03 then
                vu:SendKeyEvent(true,  Enum.KeyCode.X, false, game)
                task.wait(0.01)
                vu:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                lastXPress = tick()
            end
            if now - TPLastTP >= 3 then
                TPStatusLabel.Text = "Looping  ·  X spam active"
                if TeleportToItemCache() then TPLastTP = now end
            end
            task.wait()
        end
        TPLoopConnection = nil
    end)
end

local function StopTPLoop()
    if TPLoopConnection then pcall(task.cancel, TPLoopConnection) TPLoopConnection = nil end
    TPStatusLabel.Text = ""
    HintLabel.Visible  = true
end

local function StartLootLoop()
    if LootLoopConnection then return end
    HintLabel.Visible = false
    LootLoopConnection = task.spawn(function()
        local vu         = game:GetService("VirtualInputManager")
        local lastXPress = 0
        local lootFolder = workspace:FindFirstChild("LootFolder")
        if not lootFolder then
            TPStatusLabel.Text = "No LootFolder found"
            LootLoopConnection = nil
            cfg.LootLoop = false
            HintLabel.Visible = true
            return
        end
        while cfg.LootLoop and _G.Kraken_Active do
            local startTime = tick()
            TPStatusLabel.Text = "Loot Farm running..."
            while tick() - startTime < lootLoopDuration and cfg.LootLoop and _G.Kraken_Active do
                for _, loot in ipairs(lootFolder:GetChildren()) do
                    if not cfg.LootLoop or not _G.Kraken_Active then break end
                    if loot.Name == "Loot" then
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if root then
                            root.CFrame = loot.CFrame + Vector3.new(math.random(-5,5)/10, 3, math.random(-5,5)/10)
                        end
                        local now = tick()
                        if now - lastXPress > 0.03 then
                            vu:SendKeyEvent(true,  Enum.KeyCode.X, false, game)
                            task.wait(0.01)
                            vu:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                            lastXPress = tick()
                        end
                        task.wait(lootInterval + lootTPDelay)
                    end
                end
                task.wait(0.1)
            end
            TPStatusLabel.Text = "Cycle done  ·  restarting..."
            task.wait(1)
        end
        TPStatusLabel.Text = ""
        HintLabel.Visible  = true
        LootLoopConnection = nil
    end)
end

local function StopLootLoop()
    if LootLoopConnection then pcall(task.cancel, LootLoopConnection) LootLoopConnection = nil end
    cfg.LootLoop = false
    TPStatusLabel.Text = ""
    HintLabel.Visible  = true
end

