-- ── GitHub Bundled Loader (Preprocessed_Bundled.lua) ─────────────────────────
-- Set this to your RAW GitHub URL (not github.com page URL).
local BUNDLED_RAW_URL = _G.PTG_BUNDLED_RAW_URL or "https://raw.githubusercontent.com/Recklessir/PTG-Hub/refs/heads/main/Preprocessed_Bundled.lua"
local AUTO_LOAD_BUNDLED = (_G.PTG_AUTO_LOAD_BUNDLED ~= false) and not (_G and _G.PTG_RUNNING_INSIDE_BUNDLED)
-- Modes:
--   "hybrid"       => load bundled features + keep PTG HUB running
--   "bundled_only" => load bundled features and stop PTG HUB initialization
local INTEGRATION_MODE = (_G.PTG_INTEGRATION_MODE or "hybrid")

local function loadBundledFromGitHub(rawUrl)
    if type(rawUrl) ~= "string" or rawUrl == "" or rawUrl:find("USERNAME/REPO/BRANCH", 1, true) then
        warn("[PTG] Bundled loader skipped: set _G.PTG_BUNDLED_RAW_URL to your raw GitHub URL")
        return false, "url_not_set"
    end

    local okGet, source = pcall(function()
        if syn and syn.request then
            local res = syn.request({ Url = rawUrl, Method = "GET" })
            if not res or tonumber(res.StatusCode) ~= 200 then
                error("http status " .. tostring(res and res.StatusCode))
            end
            return res.Body
        end
        if http and http.request then
            local res = http.request({ Url = rawUrl, Method = "GET" })
            if not res or tonumber(res.StatusCode) ~= 200 then
                error("http status " .. tostring(res and res.StatusCode))
            end
            return res.Body
        end
        return game:HttpGet(rawUrl, true)
    end)
    if not okGet or type(source) ~= "string" or source == "" then
        warn("[PTG] Bundled fetch failed:", tostring(source))
        return false, "fetch_failed"
    end

    local loader = loadstring or load
    if type(loader) ~= "function" then
        warn("[PTG] Bundled loader unavailable (loadstring/load missing)")
        return false, "no_loader"
    end

    local chunk, compileErr = loader(source)
    if not chunk then
        warn("[PTG] Bundled compile failed:", tostring(compileErr))
        return false, "compile_failed"
    end

    local okRun, runErr = pcall(chunk)
    if not okRun then
        warn("[PTG] Bundled runtime failed:", tostring(runErr))
        return false, "runtime_failed"
    end

    _G.PTG_BUNDLED_LAST_URL = rawUrl
    return true, "ok"
end

if AUTO_LOAD_BUNDLED then
    local okBundled, reasonBundled = loadBundledFromGitHub(BUNDLED_RAW_URL)
    if okBundled then
        _G.PTG_BUNDLED_LOADED = true
        warn("[PTG] Bundled script loaded from GitHub")
        if INTEGRATION_MODE == "bundled_only" then
            warn("[PTG] Integration mode is bundled_only; skipping PTG HUB initialization")
            return
        end
    else
        _G.PTG_BUNDLED_LOADED = false
        warn("[PTG] Bundled script did not load (" .. tostring(reasonBundled) .. ")")
    end
end

